# ============================================================
# BillVault / Fintracker Frontend — Environment Configuration
# ============================================================
# These values are embedded at build time by Expo.
# The EXPO_PUBLIC_ prefix makes them accessible via process.env in the app.
# Rename/copy to .env.local for local development.

# ---- Backend API URL ----
# Development (local backend):
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
# Production example:
# EXPO_PUBLIC_BACKEND_URL=https://api.your-domain.com

# ---- Firebase Web SDK (for Google Sign-In on web) ----
# Get from Firebase Console → Project Settings → Your apps → Web app → Config
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456
