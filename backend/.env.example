# ============================================================
# BillVault / Fintracker Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env to version control.

# ---- JWT ----
# Use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-use-a-long-random-secret-key-here

# ---- Application ----
ENVIRONMENT=development

# ---- Firebase Admin SDK (Service Account) ----
# Get these from Firebase Console → Project Settings → Service Accounts
# → Generate new private key → download the JSON, then extract:
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ---- Firebase Storage Bucket (optional) ----
# Defaults to <project_id>.appspot.com if not set
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ---- Email Service (optional — verification & password reset emails) ----
# Example using SendGrid:
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx
# FROM_EMAIL=no-reply@fintracker.app

# ---- Frontend origin (for CORS in production) ----
# FRONTEND_URL=https://your-app.com
